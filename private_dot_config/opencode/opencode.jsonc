{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "DUONGNG": {
          "name": "9Router DUONGNG",
          "limit": {
            "context": 330000,
            "output": 13000
          }
        },
      }
    }
  },
  "model": "9router/DUONGNG"
}
